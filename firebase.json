{
  "hosting": {
    "public": ".",
    "ignore": ["**/.*", "**/node_modules/**", "firebase.json", "firestore.rules", "README.md"],
    "headers": [
      { "source": "**/*.@(html|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
